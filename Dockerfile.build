# Digests resolved from the publishers' registries; see docs/reproducibility.md.
FROM python:3.12.16-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS python-base

FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS node-runtime
FROM oven/bun:1.3.11-slim@sha256:478281fdd196871c7e51ba6a820b7803a8ae97042ec86cdbc2e1c6b6626442d9 AS bun-runtime

# Native renderer releases target Ubuntu. Keep its runtime separate from Python.
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852 AS atlas
COPY --from=python-base /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY config/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update -o APT::Update::Error-Mode=any \
    && apt-get install -y --no-install-recommends \
       ca-certificates python3 libopengl0 libglx-mesa0 libgl1-mesa-dri \
       libcurl4t64 libjpeg-turbo8 libuv1t64 libicu74 libwebp7 libpng16-16t64 xvfb xauth \
    && dpkg-query --show > /opt/ck-atlas-tool-versions.txt \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /workspace/pipelines/atlas
COPY pipelines/atlas/package.json pipelines/atlas/bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY catalog/buildtools.yaml catalog/fonts.yaml tools/bootstrap_atlas.py /tmp/ck-atlas-bootstrap/
RUN python3 /tmp/ck-atlas-bootstrap/bootstrap_atlas.py \
      /tmp/ck-atlas-bootstrap/buildtools.yaml node_modules /tmp/ck-atlas-bootstrap/fonts.yaml \
    && node --version >> /opt/ck-atlas-tool-versions.txt \
    && bun --version >> /opt/ck-atlas-tool-versions.txt
COPY pipelines/atlas/ ./
ENV TZ=UTC LANG=C.UTF-8 LC_ALL=C.UTF-8 LIBGL_ALWAYS_SOFTWARE=1 LP_NUM_THREADS=1 UV_THREADPOOL_SIZE=1
ENTRYPOINT ["bun", "run"]
CMD ["render", "--help"]

FROM python-base AS build

COPY --from=ghcr.io/astral-sh/uv:0.9.24@sha256:816fdce3387ed2142e37d2e56e1b1b97ccc1ea87731ba199dc8a25c04e4997c5 /uv /uvx /usr/local/bin/

COPY config/debian.sources /etc/apt/sources.list.d/debian.sources
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 libharfbuzz-bin poppler-utils \
       apksigner zim-tools default-jre-headless dosfstools mtools zstd osmium-tool \
    && dpkg-query --show > /opt/ck-tool-versions.txt \
    && rm -rf /var/lib/apt/lists/*

COPY catalog/fonts.yaml tools/bootstrap_fonts.py /tmp/ck-bootstrap/
RUN python /tmp/ck-bootstrap/bootstrap_fonts.py /tmp/ck-bootstrap/fonts.yaml /opt/ck-fonts

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_PROGRESS=1 \
    CK_FONT_CACHE=/opt/ck-fonts

WORKDIR /workspace
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src/ ./src/
RUN uv sync --locked --no-editable
COPY . .

ENTRYPOINT ["uv", "run", "--locked", "--no-sync"]
CMD ["ck", "--help"]
