<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<meta name="dcterms.created" content="{{ timestamp }}">
<meta name="dcterms.modified" content="{{ timestamp }}">
<style>
{% for font in fonts %}
@font-face { font-family: CK{{ loop.index0 }}; src: url("{{ font.uri }}"); }
{% endfor %}
@page {
  size: letter;
  margin: 9mm 10mm 13mm;
  @bottom-center {
    content: "Preview · page " counter(page);
    font-size: 7pt;
    color: #777;
  }
  {% if kind == 'overview' %}
  @bottom-left { content: "May help; not confirmed open."; font-size: 7pt; color: #666; }
  {% endif %}
}
body, svg text { font-family: {{ families }}, sans-serif; }
body { margin: 0; font-size: 11pt; color: #222; }
h1 { font-size: 20pt; }
h2 { font-size: 13pt; margin: 0 0 2mm; }
h3 { font-size: 12pt; }
p { margin: 2mm 0; }
section { break-before: page; }
section:first-child { break-before: auto; }
svg { display: block; }
.small { font-size: 8pt; }
.source-notes { font-size: 8pt; color: #666; border-top: 0.2mm solid #bbb; padding-top: 2mm; margin-top: 3mm; }
.source-notes p { margin: 1mm 0; }
.source-line { font-size: 7pt; color: #666; }
table { border-collapse: collapse; width: 100%; font-size: 9pt; }
td, th { padding: 1.3mm; text-align: left; border-bottom: 0.2mm solid #ccc; }
a { color: #23548a; }
.map-title { height: 12mm; }
.page-meta { font-size: 7pt; line-height: 1.1; }
.locator-row { display: flex; gap: 4mm; align-items: flex-start; }
.locator { width: 94mm; flex: none; }
.locator svg { width: 94mm; height: auto; }
.locator-table { width: 88mm; flex: none; table-layout: fixed; }
</style>
</head>
<body>
{% if kind == 'detail' %}
<section>
  <h1>{{ area_name }} road maps</h1>
  <p>{{ policy.state }} · {{ policy.county_name }}</p>
  {% if policy.scope_zctas is defined %}<p>This area map covers ZIP areas {{ zctas | join(', ') }} within this county.</p>{% endif %}
  <p>Zoom and pan each map.</p>
  <p>Find your town on the locator. Open its blue sheet label below.
  At the map edge, continue on the named sheet and page.</p>
  <p>Enlarged street sheets follow the main sheets. Their index is at the end.</p>
  <div class="locator-row">
  <div class="locator">{{ locator_svg }}</div>
  <table class="locator-table">
    <tr><th>Sheet</th><th>Page</th></tr>
    {% for page in pages if page.parent is not defined %}
    <tr><td><a href="#{{ page.id }}">{{ page.id }}</a></td><td>page {{ page.page }}</td></tr>
    {% endfor %}
  </table>
  </div>
  <h3>Read the map</h3>
  <p>Orange: main roads. Gray: other roads. Dashed: paths, tracks, or private access.
  A map line is not permission or confirmation that a route is open.</p>
  <p>Grid columns A–E run left to right; rows 1–6 run top to bottom. Corner coordinates
  are decimal degrees and degrees–minutes–seconds. The arrow indicates grid north.</p>
  <p>Public places are in <strong>0_OVERVIEW.pdf</strong> in this folder.</p>
  <aside class="source-notes">
    <strong>Publication and source notes</strong>
    <p>Preview; source, safety, and phone review remain outstanding.
    Every selected street with a source name has a label. Some source roads are unnamed.</p>
    <p>Base scale 1:{{ '{:,}'.format(policy.scale_denominator) }} is an engineering trial.
    County-edge overlap uses {{ policy.state }} source data; neighboring-state navigation is not demonstrated.</p>
    <p>Census 2020 ZIP areas {{ zctas | join(', ') }} are statistical approximations,
    not current USPS delivery boundaries.</p>
  </aside>
</section>
{% for page in pages %}
<section>
  <div class="map-title">
    <h2 id="{{ page.id }}">{{ area_name }} · {{ page.id }}</h2>
    <p class="page-meta">{{ page.continuation }} · Scale
    1:{{ '{:,.0f}'.format(page.effective_scale_denominator) }}</p>
  </div>
  {{ page.svg }}
  <p class="source-line">OSM/Geofabrik 2026-10-29; Protomaps 2026-10-30.
  © OpenStreetMap contributors, ODbL-1.0. County: Census 2025. No live closure information.</p>
</section>
{% endfor %}
<section>
  <h2>Enlarged street sheets</h2>
  <p>Open the sheet for your street. Parent is the county map sheet shown on the locator.</p>
  <table>
    <thead><tr><th>Nearby street</th><th>Sheet and page</th><th>Parent</th></tr></thead>
    <tbody>
    {% for page in pages if page.parent is defined %}
    <tr><td>{{ page.target_name }}</td><td><a href="#{{ page.id }}">{{ page.id }} · page {{ page.page }}</a></td>
    <td>{{ page.parent }} · page {{ page.parent_page }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
</section>
{% else %}
<section>
  <div class="map-title">
    <h2>{{ area_name }} overview</h2>
    <p class="source-line">Colored boundaries: 2020 Census ZIP areas {{ zctas | join(', ') }}.</p>
  </div>
  {{ overview_svg }}
  <p class="source-line">Detailed maps: {{ leaf }}.
  © OpenStreetMap contributors, ODbL-1.0; Census.</p>
  <p class="source-line">Places are numbered; see Public places. May help; not confirmed open.</p>
</section>
<section>
  <h2>Public places</h2>
  <p class="small">May help; not confirmed open.</p>
  <table>
    <thead><tr><th>No.</th><th>Name</th><th>Category and address</th></tr></thead>
    <tbody>
    {% for point in pois %}
    <tr><td>{{ point.number }}</td><td>{{ point.name }}</td>
    <td>{{ point.category | replace('_', ' ') }}<br>{{ point.address or 'Address not supplied' }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  <aside class="source-notes">
  <strong>Publication and source notes</strong>
  <p>NCES 2024–2025; IMLS 2024; OSM 2026-10-29; FCC 2026-10-31; Census 2025.
  The reused parent directory remains incomplete; this rendering adds no new source records.
  Source, safety, and phone review remain outstanding.</p>
  <p>ZIP areas are Census 2020 geographic approximations, not current USPS delivery
  coverage. No live opening or closure information is supplied.</p>
  </aside>
</section>
{% endif %}
</body>
</html>
