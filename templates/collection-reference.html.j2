<!doctype html><html lang="en"><head><meta charset="utf-8"><title>{{ title }}</title>
<meta name="dcterms.created" content="{{ timestamp }}"><meta name="dcterms.modified" content="{{ timestamp }}">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; font-src file:">
<style>
{% for font in fonts %}@font-face { font-family: 'CK{{ loop.index }}'; src: url('{{ font }}'); }{% endfor %}
{{ css | safe }}
body, code, pre, kbd, samp { font-family: {% for font in fonts %}'CK{{ loop.index }}', {% endfor %}sans-serif; }
@page { size: 90mm 160mm; font-family: {% for font in fonts %}'CK{{ loop.index }}', {% endfor %}sans-serif;
  @bottom-left { content: '{% if pack.status != 'reviewed' %}Draft reference · {% endif %}{{ modified }}'; font-size: 8pt; }
}
table { table-layout: fixed; }
td, th { overflow-wrap: anywhere; vertical-align: top; }
pre { white-space: pre-wrap; }
.omitted-figure { font-style: italic; }
{% include "source-math.css" %}
.source-table { border-top: 2pt solid #555; margin-block: 1em; }
.source-cell { border-left: 1pt solid #888; padding-left: .3em; margin-bottom: .7em; }
.mw-editsection { display: none; }
</style></head><body>
<h1>{{ title }}</h1>
{% if pack.status != "reviewed" %}<p class="draft">DRAFT REFERENCE — source accuracy and suitability review pending</p>{% endif %}
<p>{{ pack.title }}. Follow START and the printed cards when guidance differs.</p><p>Source figures are unavailable. Essential information may be missing. Use this as background reference, with training and illustrated instructions.</p>
<p>Article last edited: {{ modified }}. Archive: {{ source_version }}.</p>
<p>Source: <a href="{{ url }}">{{ title }}</a>, contributors to the original article.
<a href="{{ license_url }}">Creative Commons Attribution-ShareAlike</a>.
Formatting and offline navigation adapted by Common Knowledge.</p>
<nav aria-label="Contents"><h2>Contents</h2><ol>
{% for heading in headings %}<li><a href="#{{ heading.id }}">{{ heading.title }}</a></li>{% endfor %}
</ol></nav>
<main>{{ body }}</main>
{% if pack.collection == "med_lib" %}<h2>If 911 does not answer</h2>
<p>Open START → Medical basics. Follow its instructions and printed cards while seeking trained help. These physiology articles do not replace clinical instructions.</p>{% endif %}
<p>Original article and contributors: <a href="{{ url }}">{{ url }}</a>.
This converted article is available under <a href="{{ license_url }}">{{ license_url }}</a>.</p>
</body></html>
